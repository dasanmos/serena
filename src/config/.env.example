# ============================================================
# SERENA - VARIABLES DE ENTORNO
# Entorno: PRODUCCIÓN / InfinityFree
# ============================================================
#
# IMPORTANTE:
# - NO subir este archivo a GitHub.
# - NO compartir públicamente este archivo.
# - Las claves y contraseñas deben mantenerse privadas.
# ============================================================


# ------------------------------------------------------------
# 1. BASE DE DATOS - INFINITYFREE
# ------------------------------------------------------------

DB_HOST=localhost
DB_NOMBRE=serena
DB_USUARIO=root
DB_PASSWORD=


# ------------------------------------------------------------
# 2. CORREO SALIENTE - BREVO API
# ------------------------------------------------------------
#
# Se utiliza HTTPS mediante la API de Brevo en lugar de SMTP.
# Esto evita depender del puerto 587, que puede estar bloqueado
# por el hosting.
#
# Usado para:
# - Recuperación de contraseña
# - Envío de credenciales de importación masiva
#
# Si BREVO_API_KEY está vacío, Serena puede continuar funcionando
# utilizando los mecanismos alternativos definidos por el sistema.
#
# API Keys de Brevo:
# https://app.brevo.com/settings/keys/api
# ------------------------------------------------------------

BREVO_API_KEY=
SMTP_DESDE=correo@tudominio.edu.co
SMTP_DESDE_NOMBRE=Serena


# ------------------------------------------------------------
# 3. reCAPTCHA v2
# ------------------------------------------------------------
#
# Se utiliza en login.php para la casilla:
# "No soy un robot"
#
# Administración de reCAPTCHA:
# https://www.google.com/recaptcha/admin
# ------------------------------------------------------------

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=


# ------------------------------------------------------------
# 4. IA - OPENROUTER (modelos gratuitos)
# ------------------------------------------------------------
#
# Se utiliza para: tarjeta "Análisis de datos", informes del
# psicólogo y resumen de temas de las encuestas.
# Si OPENROUTER_API_KEY se deja vacío, Serena usa las plantillas
# fijas de src/helpers/analisis.php (todo sigue funcionando).
#
# Crear la clave: https://openrouter.ai/keys
#
# OPENROUTER_MODELOS (opcional): lista fija separada por comas,
#   p. ej. modelo-a:free,modelo-b:free. Vacío = Serena descubre
#   sola los modelos gratis vigentes (recomendado: rotan seguido).
# OPENROUTER_DATA_COLLECTION: deny = solo proveedores que no
#   guardan ni entrenan con los datos (recomendado, hay datos de
#   menores). allow = acepta cualquier proveedor gratis.
# OPENROUTER_DATA_COLLECTION_ANALISIS (opcional): igual, pero solo para
#   los resúmenes de cifras agregadas (sin nombres). Vacío = usa el global.
# ------------------------------------------------------------

OPENROUTER_API_KEY=
OPENROUTER_MODELOS=
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_DATA_COLLECTION_ANALISIS=
OPENROUTER_DATA_COLLECTION_AYUDA=
OPENROUTER_AYUDA_MAX_DIA=200
OPENROUTER_MAX_INTENTOS=4
APP_URL=

# ------------------------------------------------------------
# 5. CLAVE DE CIFRADO PARA VERIFICACIÓN EN 2 PASOS
# ------------------------------------------------------------
#
# AES-256-GCM
#
# Debe contener 64 caracteres hexadecimales.
#
# IMPORTANTE:
# Guarda una copia segura de esta clave.
# Si se pierde, puede ser necesario reactivar la verificación
# en 2 pasos de los usuarios.
# ------------------------------------------------------------

SERENA_2FA_KEY=


# ------------------------------------------------------------
# 6. CRON DE RECORDATORIOS
# ------------------------------------------------------------
#
# Endpoint:
# public/tareas/recordatorios.php
#
# El servicio externo puede llamar a este endpoint cada
# 15 minutos utilizando:
#
# ?secreto=TU_SECRETO
#
# Si el secreto es incorrecto, el endpoint responde 403.
#
# Generar un secreto nuevo:
#
# php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
# ------------------------------------------------------------

RECORDATORIOS_CRON_SECRETO=


# ------------------------------------------------------------
# 7. CRON DE RESPALDOS AUTOMÁTICOS
# ------------------------------------------------------------
#
# Se utiliza para permitir que Serena ejecute el proceso de
# respaldo automático mediante un servicio externo de cron.
#
# El diagnóstico de "Salud del sistema" comprueba esta variable.
#
# Generar un secreto NUEVO en Linux Mint:
#
# php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
#
# IMPORTANTE:
# NO reutilices el secreto de RECORDATORIOS_CRON_SECRETO.
# ------------------------------------------------------------

RESPALDO_CRON_SECRETO=


# ============================================================
# FIN DEL ARCHIVO .ENV
# ============================================================